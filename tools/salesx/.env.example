# salesx configuration — copy to .env and fill in.
# Both blocks are optional individually: commands only require the credentials
# for the providers they actually touch (e.g. `crm` needs Close; the
# `linkedin`/`x`/`google`/`chatgpt`/`seo` groups need the Marketing backend).

# --- Marketing intelligence backend (LinkedIn, X, Google, ChatGPT, SEO) ---
MARKETING_API_KEY=mk_live_xxxxxxxxxxxx
MARKETING_BASE_URL=https://your-backend-host
# bearer (default) sends `Authorization: Bearer <key>`; set to x-api-key to send `X-API-Key: <key>`.
MARKETING_AUTH_STYLE=bearer

# --- Close CRM ---
CLOSE_API_KEY=api_xxxxxxxxxxxx
